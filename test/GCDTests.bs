package GCDTests where

import qualified GCD
import qualified FibonacciRegisters
import StmtFSM
import Assert

liftToStmt :: Action -> Stmt
liftToStmt = s

testBench :: Module Empty
testBench =
  module
    gcd :: GCD.GCD <- GCD.mkGcd

    let check :: UInt 32 -> UInt 32 -> UInt 32 -> Stmt
        check a b expected = do
          liftToStmt $ action
            gcd.GCD.start a b
          liftToStmt $ await (not gcd.GCD.busy)
          liftToStmt $ action
            $display "gcd(%0d, %0d) = %0d" a b gcd.GCD.result
            dynamicAssert (gcd.GCD.result == expected) "GCD doesn't match expected value"

        testSeq :: Stmt
        testSeq = do
          check 36 24 12
          check 1071 462 21
          check 17 5 1
          check 100 100 100
          check 7 0 7

          liftToStmt $ $display "All tests passed"
    _ <- mkAutoFSM testSeq
